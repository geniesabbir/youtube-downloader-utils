Screen {
    background: #020617;
    color: #e2e8f0;
}

#workspace {
    padding: 1 2;
    height: auto;
}

#system-status {
    background: #0f172a;
    color: #94a3b8;
    padding: 0 1;
    margin-bottom: 1;
    border: solid #1e293b;
}

#input-panel,
#results-panel,
.video-card {
    background: #0f172a;
    border: round #334155;
    padding: 1 2;
    margin-bottom: 1;
    height: auto;
}

.panel-header {
    color: #38bdf8;
    text-style: bold;
    margin-bottom: 1;
}

Input {
    background: #020617;
    color: #cbd5f5;
    border: tall #1d4ed8;
}

#analyze-btn {
    width: 100%;
    margin-top: 1;
    background: #065f46;
    color: #ecfdf5;
    text-style: bold;
}

#results-summary {
    color: #94a3b8;
    margin-bottom: 1;
}

#results-list {
    height: auto;
}

#empty-state {
    color: #64748b;
}

.video-title {
    color: #f8fafc;
    text-style: bold;
    margin-bottom: 1;
}

.video-meta {
    color: #cbd5e1;
    margin-bottom: 1;
}

.video-status {
    color: #38bdf8;
}

.video-actions {
    margin-top: 1;
    height: auto;
}

.video-actions Button {
    margin-right: 1;
}

ProgressBar {
    color: #60a5fa;
    height: 1;
    margin-top: 1;
}

ProgressBar > .progress--bar {
    background: #2563eb;
}
