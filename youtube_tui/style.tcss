Screen {
    background: #0b0f14;
    color: #eef2f7;
}

Header {
    background: #11161d;
    color: #f7fafc;
}

Footer {
    background: #11161d;
    color: #94a3b8;
}

#workspace {
    padding: 1 2;
    height: 1fr;
    overflow-y: auto;
}

.app-card,
.video-card {
    background: #141a22;
    border: round #283241;
    padding: 1 2;
    margin-bottom: 1;
    height: auto;
}

#topbar {
    height: auto;
}

#title-block {
    width: 1fr;
    height: auto;
}

#status-block {
    width: 28;
    height: auto;
    align: right middle;
}

.eyebrow {
    color: #7dd3fc;
    text-style: bold;
    margin-bottom: 1;
}

.section-title {
    color: #f8fafc;
    text-style: bold;
    margin-bottom: 1;
}

.mini-label {
    color: #94a3b8;
    margin-bottom: 1;
}

#hero-title {
    color: #f8fafc;
    text-style: bold;
}

#hero-copy {
    color: #94a3b8;
}

#system-status {
    background: #1b2430;
    color: #e2e8f0;
    border: round #364152;
    padding: 0 1;
    width: 100%;
}

#auth-panel {
    height: auto;
}

#input-panel {
    height: auto;
}

#results-panel {
    height: auto;
}

#auth-status {
    background: #10151c;
    color: #e2e8f0;
    border: round #2d394a;
    padding: 1 1;
    margin-bottom: 1;
}

#auth-actions {
    height: auto;
}

#discover-actions {
    height: auto;
}

#sources-hint {
    color: #64748b;
    margin-bottom: 1;
}

Input {
    background: #0f141b;
    color: #f8fafc;
    border: round #334155;
    padding: 0 1;
}

Input:focus {
    border: round #38bdf8;
}

#browser-spec-input {
    width: 1fr;
    margin-right: 1;
}

#url-input {
    width: 1fr;
    margin-right: 1;
}

Button {
    min-width: 18;
    border: none;
    text-style: bold;
    padding: 1 2;
    height: 3;
}

#export-cookies-btn {
    width: 28;
    background: #2563eb;
    color: #eff6ff;
}

#analyze-btn {
    width: 28;
    background: #10b981;
    color: #052e2b;
}

#results-summary {
    color: #94a3b8;
    margin-bottom: 1;
}

#results-list {
    height: auto;
}

#empty-state {
    color: #64748b;
    border: round #253041;
    padding: 2 2;
}

.video-kicker {
    color: #7dd3fc;
    text-style: bold;
    margin-bottom: 1;
}

.video-title {
    color: #f8fafc;
    text-style: bold;
    margin-bottom: 1;
}

.video-meta {
    color: #cbd5e1;
    margin-bottom: 1;
}

.video-status {
    color: #a7f3d0;
}

.video-actions {
    margin-top: 1;
    height: auto;
}

.video-actions Button {
    margin-right: 1;
    min-width: 16;
    height: 3;
}

ProgressBar {
    color: #60a5fa;
    background: #0f141b;
    height: 1;
    margin-top: 1;
}

ProgressBar > .progress--bar {
    background: #3b82f6;
}

.video-card.members-only {
    border: round #d97706;
}

.video-card.members-only .video-status {
    color: #fbbf24;
}

.video-card.members-only .video-kicker {
    color: #fbbf24;
}

.trim-container {
    height: auto;
    align: left middle;
    margin-top: 1;
    margin-bottom: 1;
}

.trim-label {
    width: 24;
    height: 3;
    content-align: left middle;
    color: #94a3b8;
}

.trim-input {
    width: 20;
    margin-right: 1;
    height: 3;
}
